// Debug.xcconfig — 시뮬레이터/개발 빌드 전용 오버라이드.
// Release 는 Build.xcconfig (foundone.dev) 그대로 사용.
#include "Build.xcconfig"

// 개발 중에는 로컬 dev 서버(localhost:3000)를 호출.
//  · .env.local 에 모든 키(KAKAO/ANTHROPIC 등) 보유 → AI 상권추천·로드맵 모두 동작
//  · 카카오 REST API: localhost:3000 origin 이 카카오 개발자 콘솔에 등록돼 있어 통과
//  · ⚠️ `cd apps/web && pnpm dev` (localhost:3000) 가 떠 있어야 AI 호출 성공
//  · Xcode .xcconfig 는 // 가 주석 → URL slash 는 $()/ 로 분리
WEB_APP_URL = http:/$()/localhost:3000
BU_ENVIRONMENT = development
