<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Xcode 표준 항목 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>Found.One</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- 환경 변수 (xcconfig 에서 주입) -->
    <key>SUPABASE_URL</key>
    <string>$(SUPABASE_URL)</string>
    <key>SUPABASE_ANON_KEY</key>
    <string>$(SUPABASE_ANON_KEY)</string>
    <key>BU_ENVIRONMENT</key>
    <string>$(BU_ENVIRONMENT)</string>
    <key>KAKAO_NATIVE_APP_KEY</key>
    <string>$(KAKAO_NATIVE_APP_KEY)</string>
    <key>WEB_APP_URL</key>
    <string>$(WEB_APP_URL)</string>

    <!-- 수출 규정 자가분류: 표준 HTTPS/TLS·플랫폼 암호화만 사용(KEK 복호화는 서버 측) →
         면제(exempt). 이 키가 있으면 App Store Connect 가 제출마다 암호화 질문을 묻지 않음. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- ATS: localhost 개발 서버 허용 (프로덕션 HTTPS 도메인은 기본 허용) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSExceptionDomains</key>
        <dict>
            <key>localhost</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>

    <!-- 커스텀 URL 스킴: 비밀번호 재설정 메일 링크(foundone://auth/reset)가 앱을 다시 열도록 -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.foundone.mobile</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>foundone</string>
            </array>
        </dict>
    </array>

    <!-- 권한 사유 -->
    <key>NSCameraUsageDescription</key>
    <string>영수증을 촬영해 비용을 자동으로 기록하기 위해 카메라 권한이 필요합니다.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>이미 찍은 영수증을 가져오기 위해 사진 권한이 필요합니다.</string>

    <!-- Live Activity -->
    <key>NSSupportsLiveActivities</key>
    <true/>

    <!-- 한국어 우선 -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>ko</string>
        <string>en</string>
    </array>

    <!-- 화면 방향: 세로 -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- 전체 화면 렌더링: Launch Screen 선언이 없으면 최신 iPhone 시뮬레이터에서 letterbox 로 보일 수 있음 -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- UI 진입점 (SwiftUI App lifecycle) -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>

    <!-- 한국어 우선 -->
    <key>CFBundleAllowMixedLocalizations</key>
    <true/>

    <!-- ProMotion: iPhone Pro에서 CADisplayLink/TimelineView 애니메이션 120Hz 허용 -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
</dict>
</plist>
