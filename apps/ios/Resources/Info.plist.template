<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist 템플릿 — Xcode App target 의 Info.plist 에 복사.

  사장님 채울 항목 (xxxxx 로 표시):
   • SUPABASE_URL          = https://xxxxx.supabase.co
   • SUPABASE_ANON_KEY     = eyJhbGc... (anon public key)
   • KAKAO_NATIVE_APP_KEY  = (Kakao Developers 에서 발급)
   • CFBundleURLSchemes    = kakao{NATIVE_APP_KEY} 로 변경
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- ───────────── Supabase 환경 변수 ───────────── -->
  <key>SUPABASE_URL</key>
  <string>https://xxxxx.supabase.co</string>

  <key>SUPABASE_ANON_KEY</key>
  <string>eyJhbGc-replace-with-your-anon-key</string>

  <key>BU_ENVIRONMENT</key>
  <string>production</string>

  <!-- ───────────── 카카오 로그인 ───────────── -->
  <key>KAKAO_NATIVE_APP_KEY</key>
  <string>your-kakao-native-app-key</string>

  <key>LSApplicationQueriesSchemes</key>
  <array>
    <string>kakaokompassauth</string>
    <string>kakaolink</string>
    <string>kakaoplus</string>
  </array>

  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>CFBundleURLName</key>
      <string>com.buildup.kakao</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>kakao{REPLACE_WITH_NATIVE_APP_KEY}</string>
      </array>
    </dict>
  </array>

  <!-- ───────────── 알림 권한 + Background 모드 ───────────── -->
  <key>UIBackgroundModes</key>
  <array>
    <string>remote-notification</string>
    <string>fetch</string>
    <string>processing</string>
  </array>

  <key>BGTaskSchedulerPermittedIdentifiers</key>
  <array>
    <string>com.buildup.sync</string>
  </array>

  <!-- ───────────── App Group (Widget + Live Activity 공유) ───────────── -->
  <!-- App target Capabilities 에서 App Groups: group.com.buildup.shared 추가 -->

  <!-- ───────────── Live Activity 지원 ───────────── -->
  <key>NSSupportsLiveActivities</key>
  <true/>

  <key>NSSupportsLiveActivitiesFrequentUpdates</key>
  <true/>


  <key>NSPhotoLibraryUsageDescription</key>
  <string>가게 대표 사진과 인스타 카드뉴스 슬라이드 배경으로 쓸 사진을 고르기 위해 사진 보관함 접근이 필요합니다. 예: 매장 외관 사진을 골라 내 가게 화면과 카드뉴스에 넣습니다. 선택한 사진만 사용하며 다른 사진은 읽지 않습니다.</string>

  <!-- ───────────── 한국어 우선 ───────────── -->
  <key>CFBundleDevelopmentRegion</key>
  <string>ko</string>

  <key>CFBundleLocalizations</key>
  <array>
    <string>ko</string>
    <string>en</string>
  </array>

  <!-- ───────────── 화면 방향 (세로만 — 모바일 비즈니스 앱 표준) ───────────── -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>

  <!-- ───────────── 출시 정보 ───────────── -->
  <key>CFBundleDisplayName</key>
  <string>build.up</string>

  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key>
    <string>LaunchBackground</string>
  </dict>


  <!-- ProMotion: iPhone Pro에서 CADisplayLink/TimelineView 애니메이션 120Hz 허용 -->
  <key>CADisableMinimumFrameDurationOnPhone</key>
  <true/>
</dict>
</plist>
