{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@build-up/shared": ["../../packages/shared/src/index.ts"],
      "@build-up/shared/*": ["../../packages/shared/src/*"],
      "@build-up/ai": ["../../packages/ai/src/index.ts"],
      "@build-up/ai/*": ["../../packages/ai/src/*"],
      "@build-up/integrations": ["../../packages/integrations/src/index.ts"],
      "@build-up/integrations/*": ["../../packages/integrations/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
