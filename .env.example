# ─── Supabase ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── AI API Keys ───────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Kakao Maps (optional) ─────────────────────────
NEXT_PUBLIC_KAKAO_JS_KEY=

# ─── Korean Government Open Data APIs ─────────────
# data.go.kr에서 무료 발급: https://www.data.go.kr
SEMAS_API_KEY=                  # 소상공인시장진흥공단 (상권/상가 데이터)
KFTC_API_KEY=                   # 공정거래위원회 (프랜차이즈 정보공개서)
BIZINFO_API_KEY=                # 비즈인포 (정부 지원사업)
LOCALDATA_API_KEY=              # 지방행정인허가 (localdata.go.kr)
NTS_API_KEY=                    # 국세청 (사업자 진위확인, 세금 일정)
MOIS_API_KEY=                   # 행정안전부 (인구통계)
KSTARTUP_API_KEY=               # 창업진흥원 K-Startup (창업 지원사업)
MOLIT_API_KEY=                  # 국토교통부 (건축물대장) — 선택

# ─── Mobile (Expo) ─────────────────────────────────
