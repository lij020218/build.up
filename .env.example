# ─── Supabase ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── AI API Keys ───────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Kakao Maps (optional) ─────────────────────────
NEXT_PUBLIC_KAKAO_JS_KEY=

# ─── Korean Government Open Data APIs ─────────────
# data.go.kr에서 무료 발급: https://www.data.go.kr
SEMAS_API_KEY=                  # 소상공인시장진흥공단 (상권/상가 데이터)
KFTC_API_KEY=                   # 공정거래위원회 (프랜차이즈 정보공개서)
BIZINFO_API_KEY=                # 비즈인포 (정부 지원사업)
LOCALDATA_API_KEY=              # 지방행정인허가 (localdata.go.kr)
NTS_API_KEY=                    # 국세청 (사업자 진위확인, 세금 일정)
MOIS_API_KEY=                   # 행정안전부 (인구통계)
KSTARTUP_API_KEY=               # 창업진흥원 K-Startup (창업 지원사업)
MOLIT_API_KEY=                  # 국토교통부 (건축물대장) — 선택

# ─── 외부 PG 통합 (포트원 매출 자동 동기화) ─────────
# KEK (Key-Encryption-Key) — 사장님 PG Secret 봉투 암호화의 마스터 키
# 32 bytes (AES-256) base64 인코딩
# 생성: openssl rand -base64 32
# ⚠ 이 키가 유출되면 보관된 모든 PG Secret 이 위험. .env.local 외 어디에도 저장 X
# ⚠ 키 회전 필요 시 PORTONE_KEK_BASE64_V2 추가하고 코드에서 version 분기
PORTONE_KEK_BASE64=

# ─── CODEF (한국 마이데이터·카드매출 통합 중계) ────
# https://developer.codef.io 가입 후 Sandbox / Production 키 발급
# 사장님이 사업자번호 + 생년월일 + 카드사 입금계좌만 입력하면
# 10개 카드사 매출 자동 동기화 (캐시노트 모델 합법 우회)
CODEF_ENV=sandbox                                   # sandbox | production
CODEF_CLIENT_ID=                                    # Sandbox Client ID
CODEF_CLIENT_SECRET=                                # Sandbox Client Secret
# CODEF_PROD_CLIENT_ID=                             # 정식 출시 시
# CODEF_PROD_CLIENT_SECRET=

# ─── Mobile (Expo) ─────────────────────────────────
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_WEB_API_BASE=http://localhost:3000
