# ─── Supabase ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── AI API Keys ───────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Kakao Maps ────────────────────────────────────
NEXT_PUBLIC_KAKAO_JS_KEY=        # JS 키 — 클라이언트 지도 렌더용
# ⚠️ REST API 키 (서버) — /api/data/market-recommend 상권 분석에 필수. JS 키와 다름!
#   Kakao Developers > 내 애플리케이션 > 앱 키 > "REST API 키".
#   ❗배포(Vercel)에도 반드시 동일 값 설정 — production 에서는 .env.local 폴백이 비활성(_lib/env.ts).
#   미설정 시 상권 추천이 "위치를 찾을 수 없습니다" 404 로 실패 (앱·웹 공통).
KAKAO_REST_API_KEY=
# Kakao Local API 의 KA 헤더 origin + OAuth redirect 등에 쓰는 앱 공개 URL.
#   예: 로컬 http://localhost:3000 / 운영 https://foundone.dev
NEXT_PUBLIC_APP_URL=

# ─── Korean Government Open Data APIs ─────────────
# data.go.kr에서 무료 발급: https://www.data.go.kr
SEMAS_API_KEY=                  # 소상공인시장진흥공단 (상권/상가 데이터)
KFTC_API_KEY=                   # 공정거래위원회 (프랜차이즈 정보공개서)
BIZINFO_API_KEY=                # 비즈인포 (정부 지원사업)
LOCALDATA_API_KEY=              # 지방행정인허가 (localdata.go.kr)
NTS_API_KEY=                    # 국세청 (사업자 진위확인, 세금 일정)
MOIS_API_KEY=                   # 행정안전부 (인구통계)
KSTARTUP_API_KEY=               # 창업진흥원 K-Startup (창업 지원사업)
MOLIT_API_KEY=                  # 국토교통부 (건축물대장) — 선택

# ─── 외부 PG 통합 (포트원 매출 자동 동기화) ─────────
# KEK (Key-Encryption-Key) — 사장님 PG Secret 봉투 암호화의 마스터 키
# 32 bytes (AES-256) base64 인코딩
# 생성: openssl rand -base64 32
# ⚠ 이 키가 유출되면 보관된 모든 PG Secret 이 위험. .env.local 외 어디에도 저장 X
# ⚠ 키 회전 필요 시 PORTONE_KEK_BASE64_V2 추가하고 코드에서 version 분기
PORTONE_KEK_BASE64=

# ─── CODEF (한국 마이데이터·카드매출 통합 중계) ────
# https://developer.codef.io 가입 후 Sandbox / Production 키 발급
# 사장님이 사업자번호 + 생년월일 + 카드사 입금계좌만 입력하면
# 10개 카드사 매출 자동 동기화 (캐시노트 모델 합법 우회)
CODEF_ENV=sandbox                                   # sandbox | production
CODEF_CLIENT_ID=                                    # Sandbox Client ID
CODEF_CLIENT_SECRET=                                # Sandbox Client Secret
# CODEF_PROD_CLIENT_ID=                             # 정식 출시 시
# CODEF_PROD_CLIENT_SECRET=

# ─── 팝빌 (홈택스 세금계산서·현금영수증 자동수집) ─────
# https://www.popbill.com 회원사 가입 후 발급
# 사장님 사업자번호 등록 + 홈택스 인증서 위임 시 매출/매입 자동 캐치
POPBILL_LINK_ID=                                    # 연계ID
POPBILL_SECRET_KEY=                                 # 비밀키 (44자, base64 형태)
POPBILL_IS_TEST=true                                # true=테스트, false=운영

# ─── SaaS Metrics (스타트업 사장님 자기 제품 사용자 수 자동 수집) ─
# 1) GA4 OAuth — 한국 스타트업 ~95% 가 보유. 무료 무제한.
#    Google Cloud Console > Credentials > OAuth 2.0 Client ID 발급
#    Authorized redirect URI: <APP_BASE_URL>/api/integrations/saas-metrics/ga4/callback
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
GA4_OAUTH_REDIRECT_URI=                             # 예: http://localhost:3000/api/integrations/saas-metrics/ga4/callback
# state 검증용 시크릿 (HMAC). 미설정 시 PORTONE_KEK_BASE64 폴백.
# GA4_STATE_SECRET=

# APP_BASE_URL — OAuth callback redirect 후 돌아갈 base URL.
APP_BASE_URL=                                       # 예: http://localhost:3000 / https://app.build.up

# ─── Mobile (Expo) ─────────────────────────────────
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_WEB_API_BASE=http://localhost:3000
